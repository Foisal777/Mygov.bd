# ---------------------------------------------------------------
# Netlify Function environment variables
# Site settings → Environment variables (do NOT commit the real .env)
# The browser itself reads assets/js/config.js, not these variables.
# ---------------------------------------------------------------

# Supabase project settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Must match SYNTHETIC_EMAIL_DOMAIN in assets/js/config.js
SYNTHETIC_EMAIL_DOMAIN=phone.mygov-demo.app

# true  → OTP is returned to the browser and shown on screen (no SMS cost)
# false → OTP is stored hashed; wire up SMS_API_URL for real delivery
DEMO_MODE=true
DEMO_OTP=123456

# Optional generic SMS gateway webhook (JSON POST {to, message, otp})
SMS_API_URL=
SMS_API_KEY=
