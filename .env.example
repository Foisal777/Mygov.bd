# ---------------------------------------------------------------
# Netlify Function environment variables
# Site settings → Environment variables (do NOT commit the real .env)
# The browser itself reads assets/js/config.js, not these variables.
# ---------------------------------------------------------------

# Supabase project settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Must match SYNTHETIC_EMAIL_DOMAIN in assets/js/config.js
SYNTHETIC_EMAIL_DOMAIN=phone.mygov-demo.app

# true  → OTP is returned to the browser and shown on screen (no SMS cost)
# false → OTP is stored hashed; wire up SMS_API_URL for real delivery
DEMO_MODE=true
DEMO_OTP=123456

# Optional generic SMS gateway webhook (JSON POST {to, message, otp})
SMS_API_URL=
SMS_API_KEY=

# Admin panel (Netlify Function admin-api)
# When unset and DEMO_MODE=true, the demo credentials below are accepted:
#   username: admin@mygov-demo.app (or "admin")  password: Admin@123
ADMIN_EMAIL=admin@mygov-demo.app
ADMIN_PASSWORD=
# HMAC signing secret for admin session tokens (defaults to the service key)
ADMIN_SECRET=
